<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 清空用户级源：发布构建只允许从官方 NuGet v3 源恢复，避免本机私有源注入同名包。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- 构建脚本会把 NU1901–NU1904 升格为错误；这里明确不允许静默忽略不可用源。 -->
    <add key="ignoreFailedSources" value="false" />
  </config>
</configuration>
